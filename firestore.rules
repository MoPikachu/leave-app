rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // نفس إيميلات ADMIN_EMAILS في firebase-config.js (بحروف صغيرة)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email.lower() in ['m.a.hussein98@gmail.com'];
    }
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    // admin only
    match /employees/{id} { allow read, write: if isAdmin(); }
    match /settings/{id}  { allow read, write: if isAdmin(); }

    // day board: everyone signed in reads, admin writes
    match /public/{id}    { allow read: if signedIn(); allow write: if isAdmin(); }

    // each employee's own balance (published by the admin page)
    match /mybal/{uid}    { allow read: if isSelf(uid) || isAdmin(); allow write: if isAdmin(); }

    // leave requests: the employee and the admin
    match /reqs/{uid}/items/{id} { allow read, write: if isSelf(uid) || isAdmin(); }

    // manager queue (published by the admin page)
    match /mq/{uid}       { allow read: if isSelf(uid) || isAdmin(); allow write: if isAdmin(); }

    // manager decisions
    match /mgrpub/{uid}/dec/{id} { allow read: if signedIn(); allow write: if isSelf(uid) || isAdmin(); }

    // account profiles (for linking employees to accounts)
    match /users/{uid}    { allow read: if isSelf(uid) || isAdmin(); allow write: if isSelf(uid); }
  }
}
